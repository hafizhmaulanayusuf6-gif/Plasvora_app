# Secrets and environment files
**/.env
**/.env.*
!**/.env.example

# Laravel dependencies and generated files
/backend/vendor/
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/storage/logs/*
/backend/storage/*.key
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore

# Flutter generated files
/frontend/.dart_tool/
/frontend/build/
/frontend/coverage/
/frontend/.flutter-plugins
/frontend/.flutter-plugins-dependencies
/frontend/android/.gradle/
/frontend/android/.kotlin/
/frontend/android/local.properties
/frontend/ios/Flutter/ephemeral/
/frontend/macos/Flutter/ephemeral/
/frontend/windows/flutter/ephemeral/
/frontend/linux/flutter/ephemeral/

# IDE and operating system
**/.idea/
**/*.iml
.DS_Store
Thumbs.db
